│   └── index.html        # page shell the build inlines the app into
├── test/
│   ├── sim.test.ts       # headless tests, incl. stub Line 2 connection
│   └── tsconfig.json     # compiler settings for the tests
└── dist/
    └── index.html        # built simulator (open this in a browser)